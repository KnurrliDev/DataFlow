        "defaults": {
          "light": "charts.blue",
          "dark": "charts.blue",
          "highContrast": "charts.blue",
          "highContrastLight": "charts.blue"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p ./tsconfig.webview.json && node scripts/build-webviews.mjs",
    "watch": "node scripts/build-webviews.mjs --watch",
    "pretest": "npm run compile && node scripts/prepare-fixtures.mjs",
    "test": "vscode-test",
    "test:engine": "node scripts/prepare-fixtures.mjs && node --test test/engine/protocol.test.mjs",
    "test:ui": "node scripts/prepare-fixtures.mjs && node --test test/ui/ui.test.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "package": "node scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.120.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "preact": "^11.0.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
