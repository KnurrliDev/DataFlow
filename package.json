          "highContrastLight": "#5a2db8"
        }
      },
      {
        "id": "dataflow.model",
        "description": "DataFlow: the color of the titles, the summaries and the notes of a language model.",
        "defaults": {
          "light": "#a1307f",
          "dark": "#f07fc9",
          "highContrast": "#f07fc9",
          "highContrastLight": "#7a1f5f"
        }
      },
      {
        "id": "dataflow.modelComment",
